# Copy this file to .env and fill in the values. Never commit .env.

# --- NocoDB ---
# Base URL of the NocoDB instance, e.g. https://app.nocodb.com
NOCODB_URL=

# API token: NocoDB > your avatar (top right) > Account Settings > Tokens > Add New Token
NOCODB_TOKEN=

# Table ids. Open the table in NocoDB, right-click the table in the sidebar and
# copy the id from "Copy Table ID" (or take it from the URL). Looks like: mabc123xyz456
NOCODB_TABLE_USERS=
NOCODB_TABLE_FLIGHTS=
NOCODB_TABLE_SEARCHES=
NOCODB_TABLE_BOOKINGS=
NOCODB_TABLE_PAYMENTS=
NOCODB_TABLE_FAVOURITES=

# Optional. Column id of the "user" Links field in the Search Details table,
# found in that table's API Snippet under the "Link Records" example.
# Without it, searches are still recorded but not linked back to the user.
NOCODB_SEARCHES_USER_LINK_ID=

# Required for bookings, payments and favourites. Column ids of the Links
# fields, from each table's API Snippet, same as above.
NOCODB_BOOKINGS_USER_LINK_ID=
NOCODB_BOOKINGS_FLIGHT_LINK_ID=
NOCODB_PAYMENTS_USER_LINK_ID=
NOCODB_PAYMENTS_BOOKING_LINK_ID=
NOCODB_FAVOURITES_USER_LINK_ID=
# Without this one a favourite is saved as a route (from/to) only and covers
# every flight on that route.
NOCODB_FAVOURITES_FLIGHT_LINK_ID=

# --- App ---
# Long random string used to sign JWTs
JWT_SECRET=
PORT=3500
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
